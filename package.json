{
  "name": "tmdb-year-catalog-addon",
  "version": "1.1.0",
  "description": "Stremio/Nuvio catalog addon to browse movies and series by country, release year and TMDB rating. Deployable on Vercel, Node or Docker.",
  "main": "dist/node.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "build": "tsc",
    "start": "node dist/node.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test \"tests/*.test.ts\"",
    "test:unit": "tsx --test tests/cacheService.test.ts tests/queryParser.test.ts tests/manifest.test.ts tests/http.test.ts tests/configure.test.ts tests/catalogUnit.test.ts tests/tmdbClientUnit.test.ts tests/redact.test.ts tests/usageCounter.test.ts",
    "test:integration": "tsx --test tests/catalogRoute.test.ts tests/tmdbClient.test.ts",
    "generate:logo": "node scripts/generate-logo.mjs",
    "publish:stremio": "node scripts/publish-stremio.mjs"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "nuvio",
    "alder",
    "catalog",
    "tmdb",
    "tmdb-catalog",
    "ratings",
    "movies",
    "series",
    "vercel",
    "hono"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/functions": "^2.2.13",
    "hono": "^4.6.14",
    "lru-cache": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
