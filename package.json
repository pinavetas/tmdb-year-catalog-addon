{
  "name": "imdb-year-catalog-addon",
  "version": "1.0.0",
  "description": "Stremio catalog addon to search and filter movies and series by IMDb/TMDB rating and release year",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "nuvio",
    "alder",
    "catalog",
    "imdb",
    "tmdb",
    "ratings"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "lru-cache": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
