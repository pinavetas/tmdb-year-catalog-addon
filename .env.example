# TheMovieDB API Key (REQUIRED on server unless every user supplies their own in /configure).
# Free at https://www.themoviedb.org/settings/api (supports v3 "API Key" or v4 "API Read Access Token").
TMDB_API_KEY=

# Public URL of the addon, without trailing slash (optional).
# Not needed on Vercel (automatically inferred from request headers). Useful behind a reverse proxy.
# Example: https://my-addon.vercel.app
PUBLIC_URL=

# Minimum vote threshold to avoid inflated scores from titles with few ratings
DEFAULT_MIN_VOTES_MOVIE=200
DEFAULT_MIN_VOTES_SERIES=50

# Default metadata language returned by TMDB (default: en-US)
TMDB_LANGUAGE=en-US

# Anonymous usage statistics (optional; disabled unless DATABASE_URL and USAGE_SALT are set).
# Stores only: UTC day + HMAC(USAGE_SALT, user TMDB key) + client app token. Never keys, IPs or searches.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# USAGE_SALT=<random secret, at least 16 characters>
# STATS_KEY=<random secret to read GET /stats.json?key=...>

# Standalone Node/Docker server only (ignored on Vercel)
PORT=7000
HOST=0.0.0.0
