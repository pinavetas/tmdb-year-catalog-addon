# Clave de API de TheMovieDB (OBLIGATORIA en el servidor salvo que cada usuario aporte la suya).
# Gratis en https://www.themoviedb.org/settings/api (sirve la "API Key" v3 o el "API Read Access Token" v4).
TMDB_API_KEY=

# URL pública del addon, sin barra final (opcional).
# En Vercel no hace falta: se deduce de la petición. Útil detrás de un reverse proxy.
# Ejemplo: https://mi-addon.vercel.app
PUBLIC_URL=

# Umbral mínimo de votos para evitar títulos con puntuaciones infladas por pocas valoraciones
DEFAULT_MIN_VOTES_MOVIE=200
DEFAULT_MIN_VOTES_SERIES=50

# Idioma de títulos y sinopsis devueltos por TMDB (por defecto es-ES)
TMDB_LANGUAGE=es-ES

# Solo para el servidor Node/Docker (en Vercel se ignoran)
PORT=7000
HOST=0.0.0.0
