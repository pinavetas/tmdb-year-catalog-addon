# Puerto del servidor (por defecto 7000)
PORT=7000
HOST=0.0.0.0

# URL pública del addon (para generar enlaces correctos detrás de un reverse proxy)
# Ejemplo: https://mi-addon.ejemplo.com
PUBLIC_URL=

# Clave de API de TheMovieDB (OBLIGATORIA - obtener gratis en https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Umbral mínimo de votos para evitar películas o series con puntuaciones infladas
DEFAULT_MIN_VOTES_MOVIE=200
DEFAULT_MIN_VOTES_SERIES=50
